# Supabase-projektets URL og anon-nøgle (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Kun til `npm run audit`, og kun lokalt.
#
# Auditten kan ikke maale om medlemskab virker uden en rigtig anden konto at
# maale med: den logger ind som denne bruger og beder om ting brugeren ikke maa
# se. Uden dem springer den sektionen over og siger det hoejt, i stedet for at
# lade som om den har tjekket.
#
# Brug en konto der IKKE er medlem af mindst et projekt. Er den med paa dem
# alle, beviser et groent svar ingenting.
AUDIT_PROBE_EMAIL=test@example.com
AUDIT_PROBE_PASSWORD=

# Service-role-noeglen. Nu ogsaa i runtime, ikke kun i scripts.
#
# Admin-modulet opretter og sletter konti, og begge dele bor i Supabases Auth
# Admin API, som anon-noeglen slet ikke kan naa. Der findes ingen policy der
# giver adgang og ingen migration der kan undgaa det: auth.users er bevidst
# ikke eksponeret gennem PostgREST.
#
# Noeglen omgaar hver eneste policy i skemaet. Den laeses kun i
# lib/supabase/admin.ts, som kun importeres af lib/admin-actions.ts, og hver
# eneste af de handlinger tjekker is_admin mod databasen foerst.
#
# SKAL ogsaa saettes i Vercel for Production, ellers bygger og koerer siden
# fint og fejler foerst paa den ene knap der inviterer.
SUPABASE_SERVICE_ROLE_KEY=
